# DRM Kinetic Model for DWSIM
# Velocity Units: mol/[kg.s]
# Amount Units: kmol
# Pressure: Pa

import math

R = 8.314  # J/mol·K

A_DRM = 1.29e6       # mol/(kg_cat·s)
Ea_DRM = 197000.0    # J/mol

# Constantes de adsorción en 1/Pa (convertidas de 1/bar)
def K_CH4(T): return 2.60e-2 * math.exp(+24410.0/(R*T)) / 1e5
def K_CO2(T): return 2.61e-2 * math.exp(+22585.0/(R*T)) / 1e5
def K_H2(T):  return 1.00e-5 * math.exp(+30000.0/(R*T)) / 1e5
def K_CO(T):  return 1.00e-5 * math.exp(+8220.0/(R*T))  / 1e5
def K_H2O(T): return 4.73e-6 * math.exp(+58662.0/(R*T)) / 1e5

def K_eq_DRM(T):
    K_bar2 = 6.78e14 * math.exp(-259660.0/(R*T))  # en bar²
