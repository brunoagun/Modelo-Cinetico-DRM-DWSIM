    y_CO2 = n_CO2 / n_total
    y_CO  = n_CO  / n_total
    y_H2  = n_H2  / n_total
    y_H2O = n_H2O / n_total

    p_CH4 = max(y_CH4 * P_val, 1e-13)
    p_CO2 = max(y_CO2 * P_val, 1e-13)
    p_CO  = max(y_CO  * P_val, 1e-13)
    p_H2  = max(y_H2  * P_val, 1e-13)
    p_H2O = max(y_H2O * P_val, 1e-13)

    k_DRM = A_DRM * math.exp(-Ea_DRM / (R * T_val))

    K1  = K_CH4(T_val)
    K2  = K_CO2(T_val)
    K3  = K_H2(T_val)
    K21 = K_CO(T_val)
    K23 = K_H2O(T_val)

    Omega = 1.0 + K1*p_CH4 + K2*p_CO2 + K21*p_CO + math.sqrt(K3*p_H2) + K23*p_H2O
    denom = Omega ** 2

    Keq = K_eq_DRM(T_val)
    Q   = (p_CO**2 * p_H2**2) / (p_CO2 * p_CH4)
    DF  = 1.0 - Q / Keq

